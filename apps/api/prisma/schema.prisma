generator client {
  provider = "prisma-client-js"
}

// SQLite: a single local file, no server/Docker/cloud account needed. This
// app is single-user by design (see docs/ARCHITECTURE.md section 10), so
// there was never a real reason to require Postgres just to boot.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String?
  createdAt    DateTime         @default(now())
  watchlists   Watchlist[]
  alerts       Alert[]
  backtestRuns BacktestRun[]
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  tickers   String // JSON-encoded string[] -- SQLite (this Prisma version) supports neither array nor Json columns
  createdAt DateTime @default(now())
}

/// No userId: the app is single-user, so a portfolio doesn't belong to
/// anyone in particular -- it's just "one of your paper portfolios".
model PaperPortfolio {
  id              String       @id @default(cuid())
  name            String
  cashBalance     Float
  startingBalance Float
  createdAt       DateTime     @default(now())
  orders          PaperOrder[]
}

model PaperOrder {
  id          String         @id @default(cuid())
  portfolioId String
  portfolio   PaperPortfolio @relation(fields: [portfolioId], references: [id])
  ticker      String
  side        String
  quantity    Float
  price       Float
  executedAt  DateTime       @default(now())
}

/// Phase 2 (alerts) -- schema is ready, evaluation engine is scaffolded only.
model Alert {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  ticker          String
  conditionJson   String // JSON-encoded AlertCondition
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastTriggeredAt DateTime?
}

/// Phase 2 (backtesting) -- schema is ready, backtest runner is scaffolded only.
model BacktestRun {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  name       String
  filterJson String // JSON-encoded ScannerFilter
  resultJson String // JSON-encoded BacktestResult
  createdAt  DateTime @default(now())
}

/// Durable cache for AI reports, so they survive process restarts. Phase 1's
/// AiModule uses an in-process cache first and best-effort persists here.
model AiReportCache {
  ticker      String   @id
  reportJson  String // JSON-encoded AiReport
  generatedAt DateTime @default(now())
}
