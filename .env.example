# --- Database ---
# Managed Postgres, free tier, no card: https://neon.tech -- create a project,
# copy the "Connection string" (pooled, includes ?sslmode=require) here. Used
# for the whole education platform: profile/XP, curriculum progress, journal,
# paper trading. The same database is used for both local dev and the
# deployed API -- it's a single-user app, so there's no reason to keep two.
DATABASE_URL="postgresql://user:password@ep-example-123456.region.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# --- Market data provider ---
# Free tier: https://finnhub.io/register (60 calls/min free). Leave empty to run
# against the built-in MockProvider (no key required, clearly labeled mock data).
FINNHUB_API_KEY=

# --- Price chart history ---
# Finnhub's free tier no longer includes historical candles. Free tier:
# https://twelvedata.com/pricing (800 calls/day, no card, ~10s signup). Leave
# empty to fall back to the main provider's price history (mock if no
# FINNHUB_API_KEY, or Finnhub's own -- currently always mock, see above).
TWELVEDATA_API_KEY=

# --- AI engine ---
# Free tier, no card: https://ai.google.dev (Google AI Studio -> Get API key).
# Leave empty to get labeled example AI reports instead of real ones.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash"

# Optional paid alternative to Gemini (used only if GEMINI_API_KEY is empty):
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-5"

# --- API server ---
PORT=3000
