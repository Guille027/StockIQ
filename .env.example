# --- Database & cache (apps/api) ---
# Local dev default if you run `pnpm db:up` (docker-compose Postgres). Replace with a
# free hosted Postgres (e.g. Neon, Supabase) if you don't want to install Docker.
DATABASE_URL="postgresql://stockiq:stockiq@localhost:5432/stockiq?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# --- Market data provider ---
# Free tier: https://finnhub.io/register (60 calls/min free). Leave empty to run
# against the built-in MockProvider (no key required, clearly labeled mock data).
FINNHUB_API_KEY=

# --- AI engine ---
# https://console.anthropic.com/ . Leave empty to get labeled example AI reports
# instead of live Claude-generated ones.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-5"

# --- API server ---
PORT=3000
